# Required: create this token with Telegram's @BotFather.
BOT_TOKEN=123456789:replace_with_your_bot_token

# Optional runtime settings.
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_CONCURRENT_DOWNLOADS=4
MAX_LINKS_PER_MESSAGE=3
AUDIO_BITRATE=192k
VIDEO_MAX_HEIGHT=720

# Optional but normally required when api.telegram.org is blocked.
# Supports HTTP and SOCKS5 URLs. Keep credentials secret.
# TELEGRAM_PROXY_URL=socks5://username:password@proxy-host:1080

# Optional: Netscape-format cookies for login/age-restricted media.
# Mount this file read-only in Docker; never commit or share it.
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt
