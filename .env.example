# Required: numeric part before ':' in the BotFather token. The full token is
# stored only as the BOT_TOKEN Cloudflare Worker secret, never on this server.
TELEGRAM_BOT_ID=123456789

# Optional runtime settings.
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_CONCURRENT_DOWNLOADS=4
MAX_LINKS_PER_MESSAGE=3
AUDIO_BITRATE=192k
VIDEO_MAX_HEIGHT=720

# Required: deployed Cloudflare Worker URL and its independent relay secret.
TELEGRAM_RELAY_URL=https://biradownbot-telegram-relay.YOUR_SUBDOMAIN.workers.dev
TELEGRAM_RELAY_SECRET=replace_with_a_long_random_secret

# Keep getUpdates connections short so restrictive networks/CDNs do not close
# the Cloudflare relay connection before Telegram responds.
TELEGRAM_POLL_TIMEOUT=0
TELEGRAM_POLL_INTERVAL=1.5
TELEGRAM_CONNECTION_POOL_SIZE=8

# Optional: Netscape-format cookies for login/age-restricted media.
# Mount this file read-only in Docker; never commit or share it.
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt
